# Autonomous EV Charging System - Root Environment Configuration Example
# Copy to .env for local/Docker Compose runs: cp .env.example .env

NODE_ENV=development

# Security Secrets (Shared HS256 secret & internal key)
JWT_SECRET=supersecretjwtkey_ev_2026_change_in_prod
INTERNAL_KEY=internal_secret_key_2026_ev_system

# Mocking Toggle (true = fallback mocks if downstream service unavailable)
USE_MOCK=false

# Simulation Settings
SIM_SPEEDUP=60

# Frontend Configuration
VITE_API_URL=http://localhost:5000

# MongoDB Configuration (inside Docker network: mongodb:27017; host machine: localhost:27017)
MONGO_PORT=27017
MONGO_URI=mongodb://mongodb:27017

# Microservice Ports & Base URLs
GATEWAY_PORT=5000
AUTH_PORT=5001
EV_PORT=5002
STATION_PORT=5003
BOOKING_PORT=5004
DECISION_PORT=5005
CHARGING_PORT=5006
PAYMENT_PORT=5007
NOTIFICATION_PORT=5008
ANALYTICS_PORT=5009
FRONTEND_PORT=3000

# Service URLs (for Docker Compose inter-service communication)
AUTH_SERVICE_URL=http://auth-service:5001
EV_SERVICE_URL=http://ev-service:5002
STATION_SERVICE_URL=http://station-service:5003
BOOKING_SERVICE_URL=http://booking-service:5004
DECISION_SERVICE_URL=http://decision-service:5005
CHARGING_SERVICE_URL=http://charging-service:5006
PAYMENT_SERVICE_URL=http://payment-service:5007
NOTIFICATION_SERVICE_URL=http://notification-service:5008
ANALYTICS_SERVICE_URL=http://analytics-service:5009
